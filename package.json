{
  "name": "@jusev/react-native-fold",
  "version": "0.2.3",
  "description": "Foldable and shared-display layout signals for React Native. iPhone Duo and iOS 27.1 reserved regions, plus Android folds via Jetpack WindowManager: where the fold is, which half is which, and which edge your toolbar belongs on.",
  "keywords": [
    "android",
    "dual-screen",
    "expo",
    "fold",
    "foldable",
    "foldingfeature",
    "hinge",
    "ios",
    "iphone-duo",
    "jetpack-windowmanager",
    "layout",
    "react-native",
    "reserved-regions",
    "safe-area",
    "split-view"
  ],
  "license": "MIT",
  "author": "Aleksei Jusev",
  "homepage": "https://github.com/jusev/react-native-fold#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jusev/react-native-fold.git"
  },
  "bugs": {
    "url": "https://github.com/jusev/react-native-fold/issues"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "ios",
    "android",
    "expo-module.config.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "jest"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "diagnostics": false,
          "isolatedModules": true
        }
      ]
    }
  }
}
